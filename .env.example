# =====================================================================
# FloodRelief DSS Environment & Database Configuration (Template)
# =====================================================================

APP_ENV=production
APP_DEBUG=false
APP_URL=https://floodrelief.onrender.com

# Database Configuration (PostgreSQL 15+, 16+, 17+ / Render.com Standard)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flood_relief_db
DB_USER=postgres
DB_PASS=423601
DB_SSLMODE=prefer

# Production Cloud Database (Render.com)
# When set, DATABASE_URL automatically takes precedence over individual DB_* variables:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Emergency Notification SMTP Dispatcher
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_SECURE=tls
SMTP_FROM=alerts@floodrelief.gov.in
SMTP_FROM_NAME="FloodRelief Emergency Operations Command"
