# =====================================================================
# FloodRelief DSS Environment & Database Configuration
# =====================================================================

APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration (PostgreSQL 15+, 16+, 17+ / Render.com Standard)
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=flood_relief_db
DB_USER=postgres
DB_PASS=postgres
DB_SSLMODE=prefer
# On Render.com or cloud production, set DATABASE_URL (takes highest precedence):
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Emergency Notification SMTP Dispatcher
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=none
SMTP_FROM=alerts@floodrelief.gov.in
SMTP_FROM_NAME="FloodRelief Emergency Operations Command"
